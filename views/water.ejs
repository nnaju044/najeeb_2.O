<%- include('partials/head', { title: title, page: page, active: active }) %>
<%- include('partials/topbar') %>

<main class="app-main">
  <%- include('partials/datenav', { basePath: '/water', prevDate: prevDate, nextDate: nextDate, label: dateLabel, sub: weekday, isToday: isToday }) %>

  <section class="card hero">
    <div class="hero-head">
      <div class="stack-sm">
        <p class="eyebrow">Hydration</p>
        <div class="day-number"><%= (summary.totalMl / 1000).toFixed(2) %><span> / <%= (targetMl / 1000).toFixed(1) %> L</span></div>
        <p class="muted small" id="water-remaining-text">
          <%= summary.remainingMl > 0 ? summary.remainingMl + ' ml to go' : 'Target reached — ' + summary.totalMl + ' ml logged' %>
        </p>
      </div>
      <%- include('partials/ring', { percent: summary.percent, value: Math.round(summary.percent) + '%', label: 'of target', size: 100, stroke: 9, color: 'var(--sleep)' }) %>
    </div>
    <div class="bar-track"><div class="bar-fill sleep" id="water-bar" style="width:<%= Math.min(100, summary.percent) %>%"></div></div>
    <div class="between tiny muted">
      <span><%= summary.entryCount %> entr<%= summary.entryCount === 1 ? 'y' : 'ies' %> today</span>
      <span id="water-total-label"><%= summary.totalMl %> ml</span>
    </div>
  </section>

  <section class="card tight">
    <div class="card-head">
      <div class="card-title">Add water</div>
      <span class="card-sub">One tap</span>
    </div>
    <div class="chip-grid">
      <% presets.forEach(function (amount) { %>
        <button class="chip chip-lg water" type="button" data-water-amount="<%= amount %>">
          <span><%= amount >= 1000 ? (amount / 1000) + ' L' : amount + ' ml' %></span>
          <i data-lucide="plus"></i>
        </button>
      <% }); %>
    </div>
    <div class="row" style="gap:8px">
      <input type="number" id="water-custom" min="1" max="5000" step="10" inputmode="numeric" placeholder="Custom ml" aria-label="Custom water amount in millilitres" />
      <button class="btn is-sm" type="button" id="water-custom-add">Add</button>
    </div>
    <button class="btn is-sm is-ghost" type="button" id="water-undo">
      <i data-lucide="undo-2"></i>Undo last entry
    </button>
  </section>

  <section class="card tight">
    <div class="card-head">
      <div class="card-title">Entries</div>
      <span class="card-sub"><%= dateLabel %></span>
    </div>
    <div class="list" id="water-entries">
      <% if (!summary.entries.length) { %>
        <div class="empty">
          <i data-lucide="droplets"></i>
          <span>No water logged for this day yet.</span>
        </div>
      <% } %>
      <% summary.entries.forEach(function (entry) { %>
        <div class="list-item" data-entry-id="<%= entry._id %>">
          <span class="list-item-main">
            <span class="list-item-title"><%= entry.amountMl %> ml</span>
            <span class="list-item-meta"><%= formatTime(entry.loggedAt) %></span>
          </span>
          <span class="list-item-actions">
            <button class="icon-btn" type="button" data-delete-entry="<%= entry._id %>" aria-label="Delete entry">
              <i data-lucide="trash-2"></i>
            </button>
          </span>
        </div>
      <% }); %>
    </div>
  </section>

  <section class="card tight">
    <div class="card-head">
      <div class="card-title">Last 7 days</div>
      <span class="card-sub">Target <%= (targetMl / 1000).toFixed(1) %> L</span>
    </div>
    <div class="chart-wrap sm"><canvas id="chart-water" aria-label="Water intake for the last seven days" role="img"></canvas></div>
  </section>
</main>

<script type="application/json" id="page-data"><%- safeJson({ dateKey: dateKey, week: week, targetMl: targetMl }) %></script>

<%- include('partials/bottomnav', { active: active }) %>
<%- include('partials/foot', { pageScript: 'water' }) %>
