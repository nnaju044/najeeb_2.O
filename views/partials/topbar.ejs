<header class="topbar">
  <a class="brand" href="/"><img src="/icons/Najeeb_2.O_LOGO.png" alt="Jeebs 2.O Logo" class="brand-logo" width="20" height="20" style="width:20px;height:20px;max-width:1.35em;max-height:1.35em;border-radius:5px;object-fit:contain;flex-shrink:0;vertical-align:middle" /><span>Jeebs 2.O</span></a>
  <div class="topbar-actions">
    <% if (typeof progress !== 'undefined' && progress && progress.dayNumber) { %>
      <span class="pill">Day <%= progress.dayNumber %>/<%= progress.duration %></span>
    <% } %>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch light or dark theme">
      <i data-lucide="sun-moon"></i>
    </button>
    <a class="icon-btn" href="/settings" aria-label="Settings"><i data-lucide="settings"></i></a>
  </div>
</header>
