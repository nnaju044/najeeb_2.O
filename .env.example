# Jeebs 2.O — Environment Configuration Example

# Server Configuration
PORT=4321
HOST=127.0.0.1
NODE_ENV=development

# Session Encryption Key (Required in production — minimum 32 random characters)
SESSION_SECRET=your-random-32-byte-hex-string

# MongoDB Connection String (Required in production, e.g. MongoDB Atlas)
# In development, leave blank to use the local on-disk MongoDB engine (.data/mongo)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jeebs?retryWrites=true&w=majority

# Optional: Set to true only if production is served behind an HTTP-only reverse proxy
COOKIE_INSECURE=false
